{
    "name": "ipsum3/admin",
    "description": "Administration package for Ipsum applications built with Laravel.",
    "license": "MIT",
    "authors": [
        {
            "name": "B1nj",
            "email": "postmaster@b1nj.fr"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "laravel/ui": "^4.6",
        "glhd/aire": "^2.16",
        "voku/anti-xss": "^4.1.45",
        "ipsum3/admin-assets": "dev-master@dev",
        "spomky-labs/otphp": "^11.5",
        "bacon/bacon-qr-code": "^3.1.1"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:ipsum3/admin-assets.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Ipsum\\Admin\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ipsum\\Admin\\AdminServiceProvider"
            ]
        }
    }
}
